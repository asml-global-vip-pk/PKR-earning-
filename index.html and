  appId: "1:1092045219657:web:187ab8b4d5ed40f09e9c98",
  measurementId: "G-98ZXWDD3RY"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

let currentAuthUser = null;
let currentProfile = null;
let isAdmin = false;
let chosenPlan = "None";
let allUsers = [];
let unsubUser = null;
let unsubUserDep = null;
let unsubUserWd = null;
let unsubAdminUsers = null;
let unsubAdminDep = null;
let unsubAdminWd = null;

function isAuthorizedAdmin() {
  return Boolean(currentAuthUser && currentAuthUser.email && currentAuthUser.email.toLowerCase() === ADMIN_EMAIL.toLowerCase());
}

window.akGo = function(page) {
  if (!currentAuthUser && page !== "auth") {
    page = "auth";
  }
  if (page === "admin" && !isAuthorizedAdmin()) {
    alert("Access denied: Admin privileges required.");
    page = "home";
  }
  const pages = ["auth", "home", "plans", "deposit", "withdraw", "referral", "profile", "admin"];
  pages.forEach((p) => {
    const el = document.getElementById("p-" + p);
    if (el) el.style.display = (p === page) ? "block" : "none";
  });
  const tabs = ["home", "plans", "withdraw", "referral", "profile"];
  tabs.forEach((t) => {
    const btn = document.getElementById("tab-" + t);
    if (btn) btn.className = (t === page) ? "nav-btn active" : "nav-btn";
  });
};

window.akAuthMode = function(mode) {
  document.getElementById("loginBox").style.display = (mode === "login") ? "block" : "none";
  document.getElementById("regBox").style.display = (mode === "reg") ? "block" : "none";
};

window.akLogin = async function() {
  const email = document.getElementById("loginEmail").value.trim();
  const pass = document.getElementById("loginPass").value;
  if (!email || !pass) {
    alert("Please enter email and password.");
    return;
  }
  try {
    await signInWithEmailAndPassword(auth, email, pass);
  } catch (err) {
    alert(err.message);
  }
};

window.akRegister = async function() {
  const email = document.getElementById("regEmail").value.trim();
  const pass = document.getElementById("regPass").value;
  const refCodeInput = document.getElementById("regRef").value.trim();
  if (!email || pass.length < 6) {
    alert("Enter a valid email and a password of at least 6 characters.");
    return;
  }
  try {
    const cred = await createUserWithEmailAndPassword(auth, email, pass);
    const uid = cred.user.uid;
    const myCode = "AK-" + uid.slice(0, 6).toUpperCase();
    await setDoc(doc(db, "akcg_users", uid), {
      uid,
      email,
      balance: 30,
      welcomeBonus: 30,
      plan: "None",
      blocked: false,
      refCount: 0,
      myCode,
      referredBy: refCodeInput || null,
      createdAt: serverTimestamp()
    });
  } catch (err) {
    alert(err.message);
  }
};

window.akLogout = async function() {
  await signOut(auth);
};

window.akPickPlan = function(name, amount) {
  chosenPlan = `${name} (Rs. ${amount})`;
  document.getElementById("depPlanLabel").textContent = chosenPlan;
  document.getElementById("depAmt").value = amount;
  akGo("deposit");
};

window.akSubmitDeposit = async function() {
  if (!currentAuthUser || !currentProfile) return;
  if (currentProfile.blocked) {
    alert("Account is blocked.");
    return;
  }
  const amount = Number(document.getElementById("depAmt").value);
  const tid = document.getElementById("depTid").value.trim();
  if (!amount || amount <= 0 || !tid) {
    alert("Please enter amount and Transaction ID (TID).");
    return;
  }
  try {
    await addDoc(collection(db, "akcg_deposits"), {
      uid: currentAuthUser.uid,
      email: currentAuthUser.email,
      plan: chosenPlan,
      amount,
      tid,
      status: "Pending",
      createdAt: serverTimestamp()
    });
    document.getElementById("depTid").value = "";
    alert("Deposit request submitted with Pending status.");
  } catch (err) {
    alert(err.message);
  }
};

window.akSubmitWithdraw = async function() {
  if (!currentAuthUser || !currentProfile) return;
  if (currentProfile.blocked) {
    alert("Account is blocked.");
    return;
  }
  const method = document.getElementById("wdMethod").value;
  const amount = Number(document.getElementById("wdAmt").value);
  const account = document.getElementById("wdAcc").value.trim();
  if (!amount || amount < 500 || !account) {
    alert("Minimum withdrawal is Rs. 500 and account number is required.");
    return;
  }
  try {
    await runTransaction(db, async (tx) => {
      const userRef = doc(db, "akcg_users", currentAuthUser.uid);
      const snap = await tx.get(userRef);
      if (!snap.exists()) throw new Error("Profile not found.");
      const data = snap.data();
      if (data.blocked) throw new Error("Account is blocked.");
      const bal = Number(data.balance || 0);
      if (amount > bal) throw new Error("Insufficient balance.");

      const nextBal = bal - amount;
      tx.update(userRef, { balance: nextBal });

      const wdRef = doc(collection(db, "akcg_withdrawals"));
      tx.set(wdRef, {
        uid: currentAuthUser.uid,
        email: currentAuthUser.email,
        method,
        amount,
        account,
        status: "Pending",
        createdAt: serverTimestamp()
      });
    });
    document.getElementById("wdAmt").value = "";
    alert("Withdrawal request submitted (Pending).");
  } catch (err) {
    alert(err.message);
  }
};

window.akAdminApproveDep = async function(depId) {
  if (!isAuthorizedAdmin()) return alert("Unauthorized.");
  try {
    await runTransaction(db, async (tx) => {
      const depRef = doc(db, "akcg_deposits", depId);
